options("expressions"= 500000)
library(tidymodels)library(tidyverse)library(workflows)library(tune)setwd("~/Research/Data_Analysis/ASPIS_OMICS_WG/Data/Human/")# Load the  datasetData <- read.delim("NormData_TG_Gates_Hum_invitro_Ens.txt", header=TRUE, row.names=1, sep="\t", check.names = FALSE)Data <- round(Data, digits = 2)metadata <- read.delim("TG_Hum_Vit_meta.txt", header = TRUE, row.names = 1, sep = "\t")metadata$Steatosis <- as.factor(metadata$Steatosis)# Order column & rownames, & Transpose DataData <- Data[,order(colnames(Data))]metadata <- metadata[order(rownames(metadata)),]colnames(Data) <- metadata$Suggested_nameT_Data <- as.data.frame(x = t(Data), stringsAsFactors = FALSE)T_Data <- cbind(T_Data, metadata$Steatosis)colnames(T_Data)[ncol(T_Data)] <- "Steatosis"T_Data$Steatosis <- as.factor(T_Data$Steatosis)# Split data into training (75) & testing (25) setset.seed(234589)Data_split <- initial_split(T_Data, prop = 3/4)Data_split# Extract training and testing setsData_train <- training(Data_split)Data_test <- testing(Data_split)# For parameter tuning later, create a cross validation from training dataData_CV <- vfold_cv(Data_train)# Define a Recipe: Specifies the role of each variable as # an outcome or predictor variable using a formulaData_Recipe <-   # which consists of the formula (outcome ~ predictors)  recipe(Steatosis ~ .,          data = T_Data) %>%  # and some pre-processing steps  step_nzv(all_predictors()) %>% # potentially remove variables that are highly sparse and unbalanced  step_corr(all_numeric_predictors(), threshold = .8) # potentially remove variables that have large absolute correlations with other variables
