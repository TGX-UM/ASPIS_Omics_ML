cat("\n")
}
# Load required packages
library(dplyr)
library(readr)
library(enrichR)
library(ggplot2)
library(org.Hs.eg.db)
library(stringr)
library(fs)
library(clusterProfiler)
library(DOSE)
library(enrichplot)
for (i in 1:length(file_list)) {
file <- read.csv(file_list[i])
cell_counts <- file %>%
group_by(cluster_id) %>%
summarise(count = n())
cat("File:", file_list[i], "\n")
print(cell_counts)
cat("\n")
}
# Create Output folder
output_folder <- "enrichGO_Output"
dir_create(output_folder)
# Function to perform GO term analysis and create dotplots
perform_GO_analysis <- function(data, filename, csv_filename) {
go_results <- enrichGO(gene = data$gene,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
minGSSize = 3,
maxGSSize = 500,
ont = "ALL",
pAdjustMethod = "none",
pvalueCutoff  = 0.05)
# Extract ontology info from go_results
ontology <- go_results@result$ONTOLOGY
# Filter GO results by ontology level
go_results_molecular <- go_results %>% filter(ontology == "MF")
go_results_biological <- go_results %>% filter(ontology == "BP")
go_results_cellular <- go_results %>% filter(ontology == "CC")
# Dot plots for each ontology level
dotplot_molecular <- dotplot(go_results_molecular,
title        = "Molecular Function",
showCategory = 15,
font.size = 15)
dotplot_biological <- dotplot(go_results_biological,
title        = "Biological Process",
showCategory = 15,
font.size = 15)
dotplot_cellular <- dotplot(go_results_cellular,
title        = "Cellular Component",
showCategory = 15,
font.size = 15)
# Assign the filename and GO level as a title for each plot
plot_title_molecular <- paste0("Molecular Function - ", csv_filename)
plot_title_biological <- paste0("Biological Process - ", csv_filename)
plot_title_cellular <- paste0("Cellular Component - ", csv_filename)
# Assign the title to each plot
dotplot_molecular$labels$title <- plot_title_molecular
dotplot_biological$labels$title <- plot_title_biological
dotplot_cellular$labels$title <- plot_title_cellular
# Save the plots in the output folder
ggsave(fs::path(output_folder, paste0(csv_filename, "_", filename, "_molecular.png")), plot = dotplot_molecular, dpi = 600, scale = 1, width = 12, height = 12)
ggsave(fs::path(output_folder, paste0(csv_filename, "_", filename, "_biological.png")), plot = dotplot_biological, dpi = 600, scale = 1, width = 12, height = 12)
ggsave(fs::path(output_folder, paste0(csv_filename, "_", filename, "_cellular.png")), plot = dotplot_cellular, dpi = 600, scale = 1, width = 12, height = 12)
}
# List of CSV file names with cell types
csv_files <- list.files(pattern = "*.csv")
for (i in 1:length(csv_files)) {
data <- read.csv(csv_files[i])
csv_filename <- str_remove(csv_files[i],".csv") # Extract the filename
cell_types <- unique(data$cluster_id)   # Extract unique cell types
print(paste("starting analysis files ", csv_files[i], sep=""))
for (j in 1:length(cell_types)) {
cell_type_data <- data %>% filter(cluster_id == cell_types[j])   # Filter data for the current cell type
if (nrow(cell_type_data)>1) { perform_GO_analysis(cell_type_data, cell_types[j], csv_filename)} # Run GO analysis and create dot plots
print(paste("starting analysis cell type ", cell_types[j], sep=""))
}
}
# Create the output folder
output_folder <- "GroupGO_Output"
if (!file.exists(output_folder)) {
dir.create(output_folder)
}
# List the csv files
file_names <- list.files(pattern = "\\.csv")
# Iterate over each file
for (file_name in file_names) {
data <- read.csv(file_name)
if (startsWith(file_name, "2D")) {
comparison <- "LD-ND"
} else {
comparison <- unlist(strsplit(file_name, "-"))[1]
}
# Get unique cell types
cell_types <- unique(data$cluster_id)
# Iterate over each cell type
for (cell_type in cell_types) {
subset_data <- subset(data, cluster_id == cell_type)
# Run groupGO analysis for Molecular Function Ontology
result_MF <- groupGO(
subset_data$gene,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "MF",
level = 3,
readable = FALSE
)
# Run groupGO analysis for Biological Process Ontology
result_BP <- groupGO(
subset_data$gene,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "BP",
level = 3,
readable = FALSE
)
# Run groupGO analysis for Cellular Component
result_CC <- groupGO(
subset_data$gene,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "CC",
level = 3,
readable = FALSE
)
# Generate dot plots for each ontology
mf_plot <- barplot(result_MF, showCategory = 15, title = paste(cell_type, "MF", sep = " - "))
ggsave(filename = file.path(output_folder, paste0(file_name, "_", cell_type, "_MF_dotplot.png")))
bp_plot <- barplot(result_BP, showCategory = 15, title = paste(cell_type, "BP", sep = " - "))
ggsave(filename = file.path(output_folder, paste0(file_name, "_", cell_type, "_BP_dotplot.png")))
cc_plot <- barplot(result_CC, showCategory = 15, title = paste(cell_type, "CC", sep = " - "))
ggsave(filename = file.path(output_folder, paste0(file_name, "_", cell_type, "_CC_dotplot.png")))
}
}
