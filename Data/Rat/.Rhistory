setwd("~/Research/Data_Analysis/ASPIS_OMICS_WG/Data/Rat/")
# Load the  dataset
Data <- read.delim("NormData_TG_Gates_Rat_invitro_Ens.txt", header=TRUE, row.names=1, sep="\t", check.names = FALSE)
Data <- round(Data, digits = 2)
metadata <- read.delim("TG_Rat_Vit_meta.txt", header = TRUE, row.names = 1, sep = "\t")
metadata$Steatosis <- as.factor(metadata$Steatosis)
# Order column & rownames, & Transpose Data
Data <- Data[,order(colnames(Data))]
metadata <- metadata[order(rownames(metadata)),]
colnames(Data) <- metadata$Suggested_name
T_Data <- as.data.frame(x = t(Data), stringsAsFactors = FALSE)
T_Data <- cbind(T_Data, metadata$Steatosis)
colnames(T_Data)[ncol(T_Data)] <- "Steatosis"
T_Data$Steatosis <- as.factor(T_Data$Steatosis)
# 1. Split data into training (75) & testing (25) set
set.seed(234589)
Data_split <- initial_split(T_Data, prop = 3/4)
# load the relevant libraries
library(tidymodels)
library(tidyverse)
library(workflows)
library(tune)
Data_split <- initial_split(T_Data, prop = 3/4)
Data_split
# Extract training and testing sets
Data_train <- training(Data_split)
Data_test <- testing(Data_split)
# For parameter tuning later, create a cross validation from training data
Data_CV <- vfold_cv(Data_train)
Data_Recipe <-
# which consists of the formula (outcome ~ predictors)
recipe(Steatosis ~ .,
data = T_Data) %>%
# and some pre-processing steps
step_nzv(all_predictors()) %>% # potentially remove variables that are highly sparse and unbalanced
step_corr(all_numeric_predictors(), threshold = .8) # potentially remove variables that have large absolute correlations with other variables
Data_train_preprocessed <- Data_Recipe %>%
# apply the recipe to the training data
prep(Data_train) %>%
# extract the pre-processed training dataset
juice()
Data_train_preprocessed
ML_model <-
# specify model
rand_forest() %>%
# specify that mtry parameter needs to be tuned
set_args(mtry = tune()) %>%
# select engine/package that underlies the model. Check models & packages list above
set_engine("ranger", importance = "impurity") %>%
# Choose either continuous regression or binary classification
set_mode("classification")
ML_workflow <- workflow() %>%
# add the recipe
add_recipe(Data_Recipe) %>%
# add the model
add_model(ML_model)
ML_grid <- expand.grid(mtry = c(3, 4, 5))
# extract results
ML_tune_results <- ML_workflow %>%
tune_grid(resamples = Data_CV, #CV object
grid = ML_grid, # grid of values to try
metrics = metric_set(accuracy, roc_auc) # metrics we care about
)
# Explore the results of the cross-validation
ML_tune_results %>%
collect_metrics() # Parameters that give highest accuracy & ROC can be extracted using select_best()
param_final <- ML_tune_results %>%
select_best(metric = "accuracy")
param_final
ML_workflow <- ML_workflow %>%
finalize_workflow(param_final)
ML_fit <- ML_workflow %>%
# fit on the training set and evaluate on test set
last_fit(Data_split)
ML_fit
test_performance <- ML_fit %>% collect_metrics()
test_performance
# Generate predictions from the test set
test_predictions <- ML_fit %>% collect_predictions()
test_predictions
# Generate a confusion matrix
test_predictions %>%
conf_mat(truth = Steatosis, estimate = .pred_class)
final_model <- fit(ML_workflow, TG_Human)
