library(VennDiagram)
# Load the data
rf_data <- read_excel("~/Desktop/Filtered_RF_Importance.xlsx")
degs_data <- read.delim("~/Desktop/Steatoticx1+Non_steatoticx-1_chosen_cutOff.txt")
# Extract the specific columns
rf_features <- rf_data$Variable
deg_features <- degs_data$`logFC>= 0`
# Create the Venn diagram
venn.plot <- venn.diagram(
x = list("Random Forest" = rf_features, "DEGs" = deg_features),
category.names = c("Random Forest", "DEGs"),
filename = NULL,
fill = c("red", "green"),
alpha = 0.5,
cex = 2,
cat.cex = 2,
cat.pos = 0,
cat.dist = 0.03,
cat.just = list(c(1, -1), c(-1, -1)),
main = "Overlap of Important Features Identified by Random Forest and DEGs"
)
