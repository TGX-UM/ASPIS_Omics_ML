setwd("~/Research/Data/ASPIS_OMICS/Ensembl_ID/Human/")
# Load files and perform column manipulation
Data <- read.delim("NormData_TG_Gates_Human_In_Vitro_Ens.txt", header=TRUE, row.names=1, sep="\t", check.names = FALSE)
metadata <- read.delim("TG_Human_In_Vitro_metadata.tsv", header = TRUE, sep = "\t")
Data <- Data[,order(colnames(Data))]
metadata <- metadata[order(rownames(metadata)),]
colnames(Data) <- metadata$Suggested_name
# Count the number of genes before filtering
count_before <- nrow(Data)
# Apply the filter to remove genes based on the maximum value in each row
Data_filtered <- Data[apply(Data, 1, max) >= 6, ]
# Count the number of genes after filtering
count_after <- nrow(Data_filtered)
# Calculate the number of genes removed
count_removed <- count_before - count_after
# Transpose the dataframe & add Steatosis column
T_Data <- as.data.frame(x = t(Data_filtered), stringsAsFactors = FALSE)
T_Data <- cbind(T_Data, metadata$Steatosis)
colnames(T_Data)[ncol(T_Data)] <- "Steatosis"
T_Data$Steatosis <- as.factor(T_Data$Steatosis)
# i. Data for max filter plot
plot_data_max <- data.frame(
Status = factor(c("Before Filter", "After Filter", "Removed by Filter"),
levels = c("Before Filter", "After Filter", "Removed by Filter")),
Count = c(count_before, count_after, count_removed),
Filter = "Max Filter"
)
# Visualize data summary
barplot <- ggplot(plot_data_max, aes(x = Status, y = Count, fill = Status)) +
geom_bar(stat = "identity", width = 0.6) +
scale_fill_brewer(palette = "Set3") +
labs(
title = "Gene Counts Before and After Max Filter",
x = "Filter Status",
y = "Number of Genes"
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(hjust = 0.5),
axis.title.x = element_text(face = "bold"),
axis.title.y = element_text(face = "bold"),
axis.text.x = element_text(angle = 0, hjust = 0.8),
legend.position = "none"
) +
geom_text(aes(label = Count), vjust = -0.5, size = 4, fontface = "bold")
# Print the plot
print(barplot)
# NB: Tidymodels treats the first level as the event
levels(T_Data$Steatosis)
# In our case, the first level is No, so we need to reorder the events
T_Data$Steatosis <- relevel(T_Data$Steatosis, ref = "Yes")
levels(T_Data$Steatosis)
set.seed(456)
Data_CV <- bootstraps(T_Data, times = 5, strata = Steatosis)
Data_CV
Data_CV_boots <- tidy(Data_CV)
ggplot(Data_CV_boots, aes(x = Resample, y = Row, fill = Data)) +
geom_tile() +
scale_fill_brewer()
